meta {
  name: get-single
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/items/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A3: single item returns full data with registered_by", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.id).to.equal(1);
    expect(res.body.data.status).to.equal("in-storage");
    expect(res.body.data.registered_by).to.have.all.keys("id", "name");
    expect(res.body.data.storage_shelf).to.be.a("string");
  });
}
