meta {
  name: scoping-agent
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/items
  body: none
  auth: bearer
}

auth:bearer {
  token: {{agentToken}}
}

tests {
  test("A3: agent sees only items at their assigned terminals", function() {
    expect(res.status).to.equal(200);
    res.body.data.forEach(item => {
      expect([1, 3]).to.include(item.terminal.id);
    });
  });
}
