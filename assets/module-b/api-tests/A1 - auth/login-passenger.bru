meta {
  name: login-passenger
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/passenger/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "passenger1@email.com", "password": "passenger123" }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("passengerToken", res.body.data.token);
  }
}

tests {
  test("A1: passenger login issues a token from the separate passenger system", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.token).to.be.a("string");
  });
}
