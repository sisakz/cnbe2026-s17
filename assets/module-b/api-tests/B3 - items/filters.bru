meta {
  name: filters
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/items?status=in-storage&terminal_id=2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("B3: status and terminal filters return the correct subset", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(17);
    res.body.data.forEach(item => {
      expect(item.status).to.equal("in-storage");
      expect(item.terminal.id).to.equal(2);
    });
  });
}
