meta {
  name: suggestions
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/claims/1/matches
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  if (res.status === 200 && res.body.data.length > 0) {
    bru.setEnvVar("matchItemId", res.body.data[0].item.id);
  }
}

tests {
  test("A6: suggestions return exactly the items scoring 40 or more, ranked", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array").with.lengthOf(4);
    expect(res.body.data.map(m => m.score)).to.eql([100, 70, 50, 45]);
  });

  test("A6: top suggestion carries the full score breakdown", function() {
    const top = res.body.data[0];
    expect(top.breakdown).to.eql({ brand: 30, colour: 25, terminal: 20, date: 25 });
    expect(top.item.category).to.equal("jewellery");
    expect(top.item.status).to.equal("in-storage");
  });

  test("A6: every suggestion is an in-storage item of the claim's category", function() {
    res.body.data.forEach(m => {
      expect(m.item.status).to.equal("in-storage");
      expect(m.item.category).to.equal("jewellery");
      expect(m.score).to.be.at.least(40);
    });
  });
}
