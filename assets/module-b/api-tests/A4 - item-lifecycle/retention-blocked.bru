meta {
  name: retention-blocked
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/items/10/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "status": "disposed" }
}

tests {
  test("A4: disposing an item inside the retention period returns 422", function() {
    expect(res.status).to.equal(422);
    expect(res.body.message).to.equal("Item is still within the retention period");
  });
}
