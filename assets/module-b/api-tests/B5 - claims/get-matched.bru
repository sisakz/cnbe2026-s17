meta {
  name: get-matched
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/claims/3
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("B5: matched claim exposes matched_item with shelf", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("matched");
    expect(res.body.data.matched_item).to.have.all.keys("id", "reference_code", "storage_shelf");
  });
}
