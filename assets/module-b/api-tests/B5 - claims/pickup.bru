meta {
  name: pickup
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/claims/18/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "status": "under-review" }
}

tests {
  test("B5: submitted claim can be picked up to under-review", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("under-review");
  });
}
