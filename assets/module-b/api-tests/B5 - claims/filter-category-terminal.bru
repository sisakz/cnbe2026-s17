meta {
  name: filter-category-terminal
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/claims?category=jewellery&terminal_id=1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("B5: category and terminal filters return the correct subset", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(1);
    res.body.data.forEach(claim => {
      expect(claim.category).to.equal("jewellery");
      expect(claim.terminal.id).to.equal(1);
    });
  });
}
