meta {
  name: item-now-matched
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/items/{{matchItemId}}
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("B6: the matched item's status changed to matched", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("matched");
  });
}
