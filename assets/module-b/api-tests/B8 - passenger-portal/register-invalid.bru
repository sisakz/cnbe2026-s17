meta {
  name: register-invalid
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/passenger/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "first_name": "Dup",
    "last_name": "Licate",
    "email": "passenger1@email.com",
    "address_1": "1 Test Street",
    "city": "Shanghai",
    "postcode": "200000",
    "country": "China",
    "password": "short"
  }
}

tests {
  test("B8: duplicate email and short password are rejected with 422", function() {
    expect(res.status).to.equal(422);
    expect(res.body.message).to.equal("Validation failed");
    expect(res.body.errors).to.have.property("email");
    expect(res.body.errors).to.have.property("password");
  });
}
