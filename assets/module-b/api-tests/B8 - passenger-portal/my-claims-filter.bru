meta {
  name: my-claims-filter
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/passenger/claims?status=resolved
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

tests {
  test("B8: status filter works on the passenger's claims", function() {
    expect(res.status).to.equal(200);
    expect(res.body.meta.total).to.equal(8);
    res.body.data.forEach(claim => expect(claim.status).to.equal("resolved"));
  });
}
