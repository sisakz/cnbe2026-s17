meta {
  name: get-single
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/items/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  const d = res.body && res.body.data;
  bru.setVar("itemDetailOk",
    res.status === 200 && d && d.id === 1 && d.status === "in-storage"
      && d.registered_by && typeof d.registered_by.id === "number"
      && typeof d.registered_by.name === "string" && typeof d.storage_shelf === "string"
      ? "ok" : "detail failed: status " + res.status);
}

