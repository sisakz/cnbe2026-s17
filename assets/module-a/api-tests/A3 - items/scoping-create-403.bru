meta {
  name: scoping-create-403
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{agentToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "terminal_id": 2,
    "category": "keys",
    "description": "bunch of keys",
    "found_on": "2026-07-01",
    "found_location": "Gate E5"
  }
}

tests {
  test("A3: agent cannot register an item at a terminal not assigned to them", function() {
    expect(res.status).to.equal(403);
    expect(res.body.message).to.equal("Forbidden");
  });
}
