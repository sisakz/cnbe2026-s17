  token: {{adminToken}}
}

tests {
  test("A3.5: GET /items/{id} returns the full item with registered_by; 404 for unknown id", function() {
    expect(bru.getVar("itemDetailOk")).to.equal("ok");
    expect(res.status).to.equal(404);
    expect(res.body.message).to.equal("Resource not found");
  });
}
