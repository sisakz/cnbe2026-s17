meta {
  name: status-login-200
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "admin1@reclaim-pvg.cn", "password": "admin123" }
}

script:post-response {
  if (res.status === 200) {
    bru.setEnvVar("adminToken", res.body.data.token);
  }
  bru.setVar("statusLoginOk", res.status === 200 ? "ok" : "login returned " + res.status);
}
