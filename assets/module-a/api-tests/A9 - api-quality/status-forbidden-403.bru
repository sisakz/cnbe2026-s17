tests {
  test("A9.2: Exact status codes where framework defaults differ: login 200 (not 201), validation 422 (not 400), not-allowed 403 (not 401)", function() {
    expect(bru.getVar("statusLoginOk")).to.equal("ok");
    expect(bru.getVar("statusValidationOk")).to.equal("ok");
    expect(res.status).to.equal(403);
  });
}
