meta {
  name: resolve
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/claims/2/resolve
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("B6: resolving a matched claim sets resolved_at", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("resolved");
    expect(res.body.data.resolved_at).to.not.equal(null);
  });
}
