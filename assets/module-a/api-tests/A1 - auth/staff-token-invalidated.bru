meta {
  name: staff-token-invalidated
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/items
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("A1.5: POST /logout returns 200 and the old staff token is rejected with 401 afterwards", function() {
    expect(bru.getVar("staffLogoutOk")).to.equal("ok");
    expect(res.status).to.equal(401);
    expect(res.body.message).to.equal("Unauthenticated");
  });
}
