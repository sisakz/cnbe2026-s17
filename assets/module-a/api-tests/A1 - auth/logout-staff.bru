meta {
  name: logout-staff
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  bru.setVar("staffLogoutOk",
    res.status === 200 && res.body.message === "Logged out successfully"
      ? "ok" : "logout failed: status " + res.status);
}

