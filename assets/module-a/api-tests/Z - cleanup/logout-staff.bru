post {
  url: {{baseUrl}}/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("Z: staff logout returns 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("Logged out successfully");
  });
}
