meta {
  name: logout-passenger
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/passenger/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

tests {
  test("Z: passenger logout returns 200", function() {
    expect(res.status).to.equal(200);
    expect(res.body.message).to.equal("Logged out successfully");
  });
}
