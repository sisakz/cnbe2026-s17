meta {
  name: passenger-access
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/terminals
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

tests {
  test("A2: passengers can list all terminals for the claim form", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.be.an("array").with.lengthOf(4);
    const codes = res.body.data.map(t => t.code).sort();
    expect(codes).to.eql(["PVG-S1", "PVG-S2", "PVG-T1", "PVG-T2"]);
  });
}
