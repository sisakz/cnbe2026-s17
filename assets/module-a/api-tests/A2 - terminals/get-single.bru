meta {
  name: get-single
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/terminals/2
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

script:post-response {
  const d = res.body && res.body.data;
  bru.setVar("terminalDetailOk",
    res.status === 200 && d && d.code === "PVG-T2" && d.name === "Terminal 2"
      && d.items_in_storage_count === 17 && d.open_claims_count === 4
      ? "ok" : "detail failed: status " + res.status);
}

