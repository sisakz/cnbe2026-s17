meta {
  name: track-public
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/claims/track/{{newClaimRef}}
  body: none
  auth: none
}

tests {
  test("B8: public tracking returns claim status without personal data", function() {
    expect(res.status).to.equal(200);
    const d = res.body.data;
    expect(d.reference_code).to.equal(bru.getEnvVar("newClaimRef"));
    expect(d.status).to.equal("withdrawn");
    expect(d.terminal).to.have.all.keys("name", "code");
    expect(d).to.not.have.property("passenger");
    expect(d).to.not.have.property("description");
  });
}
