meta {
  name: update
  type: http
  seq: 9
}

put {
  url: {{baseUrl}}/items/{{createdItemId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "brand": "Sony", "colour": "navy", "description": "portable bluetooth speaker, navy mesh pouch" }
}

tests {
  test("B3: item update returns 200 with updated fields", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.colour).to.equal("navy");
    expect(res.body.data.status).to.equal("registered");
  });
}
