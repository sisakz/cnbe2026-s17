meta {
  name: claim-detail
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/passenger/claims/1
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

script:post-response {
  const d = res.body && res.body.data;
  bru.setVar("ownClaimOk",
    res.status === 200 && d && /^CL-[A-Z0-9]{8}$/.test(d.reference_code)
      && !("passenger" in d)
      ? "ok" : "own-claim case failed: status " + res.status);
}

