meta {
  name: login-inactive
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/passenger/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "passenger31@email.com", "password": "passenger123" }
}

tests {
  test("A8.5: POST /passenger/login returns 401 for invalid credentials and for deactivated accounts", function() {
    expect(bru.getVar("pLoginInvalidOk")).to.equal("ok");
    expect(res.status).to.equal(401);
    expect(res.body.message).to.equal("Invalid credentials");
  });
}
