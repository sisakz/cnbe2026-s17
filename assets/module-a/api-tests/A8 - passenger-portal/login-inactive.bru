meta {
  name: login-inactive
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/passenger/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "passenger31@email.com", "password": "passenger123" }
}

tests {
  test("A8: deactivated passenger account is rejected with 401", function() {
    expect(res.status).to.equal(401);
    expect(res.body.message).to.equal("Invalid credentials");
  });
}
