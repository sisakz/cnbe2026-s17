meta {
  name: passenger-token-invalidated
  type: http
  seq: 20
}

get {
  url: {{baseUrl}}/passenger/profile
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

tests {
  test("A8.17: POST /passenger/logout returns 200 and the old passenger token is rejected with 401 afterwards", function() {
    expect(bru.getVar("passengerLogoutOk")).to.equal("ok");
    expect(res.status).to.equal(401);
    expect(res.body.message).to.equal("Unauthenticated");
  });
}
