meta {
  name: track-404
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/claims/track/CL-NOTFOUND
  body: none
  auth: none
}

tests {
  test("A8.16: GET /claims/track/{referenceCode} works without auth, returns the status subset without passenger data; 404 for unknown codes", function() {
    expect(bru.getVar("trackOk")).to.equal("ok");
    expect(res.status).to.equal(404);
    expect(res.body.message).to.equal("Resource not found");
  });
}
