meta {
  name: logout-passenger
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/passenger/logout
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

script:post-response {
  bru.setVar("passengerLogoutOk",
    res.status === 200 && res.body.message === "Logged out successfully"
      ? "ok" : "logout failed: status " + res.status);
}

