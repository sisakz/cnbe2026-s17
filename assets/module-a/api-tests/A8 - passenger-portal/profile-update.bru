meta {
  name: profile-update
  type: http
  seq: 16
}

put {
  url: {{baseUrl}}/passenger/profile
  body: json
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "phone": "+8613800138099", "city": "Shanghai" }
}

tests {
  test("A8: profile update returns 200 with the new values", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.phone).to.equal("+8613800138099");
  });
}
