meta {
  name: file-claim
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/passenger/claims
  body: json
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "terminal_id": 2,
    "category": "electronics",
    "brand": "Samsung",
    "colour": "white",
    "description": "White Samsung phone in transparent case",
    "lost_on": "2026-07-03",
    "flight_number": "CA912"
  }
}

script:post-response {
  if (res.status === 201) {
    bru.setEnvVar("newClaimId", res.body.data.id);
    bru.setEnvVar("newClaimRef", res.body.data.reference_code);
  }
}

tests {
  test("A8: filing a claim returns 201 with auto reference code and submitted status", function() {
    expect(res.status).to.equal(201);
    expect(res.body.data.reference_code).to.match(/^CL-[A-Z0-9]{8}$/);
    expect(res.body.data.status).to.equal("submitted");
    expect(res.body.data.matched_item).to.equal(null);
  });
}
