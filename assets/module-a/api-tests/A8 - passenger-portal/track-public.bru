meta {
  name: track-public
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/claims/track/{{newClaimRef}}
  body: none
  auth: none
}

script:post-response {
  const d = res.body && res.body.data;
  bru.setVar("trackOk",
    res.status === 200 && d && d.reference_code === bru.getEnvVar("newClaimRef")
      && d.status === "withdrawn" && d.terminal && !("passenger" in d) && !("description" in d)
      ? "ok" : "public tracking failed: status " + res.status);
}

