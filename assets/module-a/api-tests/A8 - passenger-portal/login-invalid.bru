meta {
  name: login-invalid
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/passenger/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "passenger1@email.com", "password": "wrong" }
}

script:post-response {
  bru.setVar("pLoginInvalidOk",
    res.status === 401 && res.body.message === "Invalid credentials"
      ? "ok" : "invalid-credentials case failed: status " + res.status);
}

