meta {
  name: login-invalid
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/passenger/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  { "email": "passenger1@email.com", "password": "wrong" }
}

tests {
  test("A8: invalid passenger credentials return 401", function() {
    expect(res.status).to.equal(401);
    expect(res.body.message).to.equal("Invalid credentials");
  });
}
