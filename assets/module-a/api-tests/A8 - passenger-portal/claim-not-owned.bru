meta {
  name: claim-not-owned
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/passenger/claims/18
  body: none
  auth: bearer
}

auth:bearer {
  token: {{passengerToken}}
}

tests {
  test("A8.8: GET /passenger/claims/{id} returns the passenger's own claim; 404 when the claim is not owned", function() {
    expect(bru.getVar("ownClaimOk")).to.equal("ok");
    expect(res.status).to.equal(404);
    expect(res.body.message).to.equal("Resource not found");
  });
}
