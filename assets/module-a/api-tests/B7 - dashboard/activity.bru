meta {
  name: activity
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/dashboard/activity
  body: none
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

tests {
  test("B7: activity returns 20 staff entries, newest first", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data).to.have.lengthOf(20);
    res.body.data.forEach(entry => {
      expect(entry.user).to.not.equal(null);
      expect(entry).to.have.property("action");
      expect(entry).to.have.property("details");
    });
    const dates = res.body.data.map(e => new Date(e.created_at).getTime());
    for (let i = 1; i < dates.length; i++) {
      expect(dates[i - 1]).to.be.at.least(dates[i]);
    }
  });

  test("B7: activity logs were auto-created by the actions performed in this run", function() {
    expect(res.body.data[0].action).to.equal("claim_resolved");
    expect(res.body.data[0].claim.reference_code).to.equal("CL-4EAA9FE6");
    expect(res.body.data[2].action).to.equal("claim_matched");
    expect(res.body.data[2].claim.reference_code).to.equal("CL-F8DA73A7");
  });
}
