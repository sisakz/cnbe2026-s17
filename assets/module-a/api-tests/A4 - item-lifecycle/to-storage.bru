meta {
  name: to-storage
  type: http
  seq: 2
}

patch {
  url: {{baseUrl}}/items/116/status
  body: json
  auth: bearer
}

auth:bearer {
  token: {{adminToken}}
}

headers {
  Content-Type: application/json
}

body:json {
  { "status": "in-storage", "storage_shelf": "T1-R9-S99" }
}

tests {
  test("A4: registered item moves to in-storage when a shelf is provided", function() {
    expect(res.status).to.equal(200);
    expect(res.body.data.status).to.equal("in-storage");
    expect(res.body.data.storage_shelf).to.equal("T1-R9-S99");
  });
}
